        <source_script><![CDATA[answer = (function transformEntry(source) {

    var userEmail = source.u_user_email;

    var userGR = new GlideRecord('sys_user');
    userGR.addQuery('email', userEmail); //
	userGR.addActiveQuery();
    userGR.query();

    if (userGR.next()) {
        //return userGR.sys_id; 
        var resourceGR = new GlideRecord('x_kp101_kpmg_res_0_resource_profile');
        resourceGR.addQuery('resource_name', userGR.sys_id);
        resourceGR.query();
        if (resourceGR.next()) {
            return resourceGR.sys_id;
        } else {
            ignore = true;
            return;
        }
    } else {
        ignore = true;
        return;
    }

})(source);]]></source_script>
