        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	 var rpaGR = new GlideRecord('x_kp101_kpmg_res_0_user_project_assignment');

    
    rpaGR.addQuery('project_assignment', current.sys_id);

    // Optional: skip already completed assignments
    rpaGR.addQuery('deployment_status', '!=', 'completed');

    rpaGR.query();

    while (rpaGR.next()) {

