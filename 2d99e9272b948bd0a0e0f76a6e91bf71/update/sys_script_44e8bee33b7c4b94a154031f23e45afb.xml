        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var resourceProfile = current.user;

    if (!resourceProfile)
        return;

    // Check if user still has active/deployed assignments
    var activeGR = new GlideRecord('x_kp101_kpmg_res_0_user_project_assignment');
    activeGR.addQuery('user', resourceProfile);
    activeGR.addQuery('deployment_status', 'IN', 'active,planned');
    activeGR.query();

    var rpGR = new GlideRecord('x_kp101_kpmg_res_0_resource_profile');

    if (rpGR.get(resourceProfile)) {

        if (activeGR.hasNext()) {
            rpGR.resource_status = 'deployed';
        } 
		

        rpGR.update();
    }


})(current, previous);]]></script>
