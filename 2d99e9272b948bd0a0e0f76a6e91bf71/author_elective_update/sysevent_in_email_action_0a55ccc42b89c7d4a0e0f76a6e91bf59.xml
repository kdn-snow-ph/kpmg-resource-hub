        <order>50</order>
        <reply_email/>
        <required_roles/>
        <script><![CDATA[(function runAction( /*GlideRecord*/ current, /*GlideRecord*/ event, /*EmailWrapper*/ email, /*ScopedEmailLogger*/ logger, /*EmailClassifier*/ classifier) {

    try {
        // Get the first attachment from the email
        gs.info("Email object " + sys_email.sys_id);
		
        var attachment = new GlideRecord('sys_attachment');
        attachment.addQuery('table_sys_id', sys_email.sys_id);
        attachment.query();

        if (!attachment.next()) {
            gs.info("No attachment found in inbound email.");
            return;
        } else {
            gs.info(attachment.file_name);

        }

        var ds = new GlideRecord('sys_data_source');
        ds.initialize();
        ds.name = 'Certs Import ' + new GlideDateTime();
        ds.import_set_table_name = 'x_kp101_kpmg_res_0_servicenow_report_staging';
        ds.format = 'Excel';
        ds.header_row = 1;
        ds.sheet_number = 1;
        var dsSysId = ds.insert();

        // Copy attachment from email to data source
        GlideSysAttachment.copy(
            'sys_email',
            sys_email.sys_id,
            'sys_data_source',
            dsSysId
        );

        // Load Import Set
        var loader = new GlideImportSetLoader();
        var importSetRec = loader.getImportSetGr(ds);

        loader.loadImportSetTable(importSetRec, ds);

        importSetRec.state = 'loaded';
        importSetRec.update();

        // Run transform map
        var transformWorker = new GlideImportSetTransformerWorker(
            importSetRec.sys_id,
            "7e86f14f3b600b14a154031f23e45a9f"
        );

        transformWorker.setBackground(true);
        transformWorker.start();

        gs.info("Import completed");

    } catch (ex) {
        gs.error("Error processing inbound email import: " + ex.message, "InboundImport");
    }

})(current, event, email, logger, classifier);]]></script>
